# SMTP credentials used by app/api/contact/route.ts to send the contact form
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-password
CONTACT_TO_EMAIL=you@example.com

# Neon Postgres connection string (from neon.tech project dashboard)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# Vercel Blob token (from Vercel project Storage tab, auto-filled when linked)
BLOB_READ_WRITE_TOKEN=

# Password to access /admin — pick your own, don't share it
ADMIN_PASSWORD=
